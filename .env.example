# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider to use: "mock" (no API key needed, deterministic rule-based
# responses, used by default and by the automated test suite) or "anthropic".
AAR_LLM_PROVIDER=mock

# Required only when AAR_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Anthropic model id used for extraction/reconstruction/analysis calls.
AAR_ANTHROPIC_MODEL=claude-sonnet-5

# Path to the SQLite database file.
AAR_DB_PATH=data/aar.db

# Logging level: DEBUG, INFO, WARNING, ERROR
AAR_LOG_LEVEL=INFO

# Optional: set a password to require login before anyone can use the app
# (there is only one shared role — the AAR facilitator — so this is a single
# shared password, not individual accounts). Leave empty to disable the
# login gate entirely (anyone who can reach the URL has access — fine for
# strictly local/single-operator use, not fine if the app is reachable over
# a network).
AAR_ACCESS_PASSWORD=

# Optional: secret key used to sign login session cookies. If left empty, a
# random one is generated on first run and stored in data/.session_secret
# (gitignored) so sessions survive app restarts. Only set this explicitly if
# you need sessions to survive a full redeploy where data/ is wiped too.
AAR_SESSION_SECRET=
