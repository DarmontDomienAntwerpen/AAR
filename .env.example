# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider to use: "mock" (no API key needed, deterministic rule-based
# responses, used by default and by the automated test suite) or "anthropic".
AAR_LLM_PROVIDER=mock

# Required only when AAR_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Anthropic model id used for extraction/reconstruction/analysis calls.
AAR_ANTHROPIC_MODEL=claude-sonnet-5

# Path to the SQLite database file.
AAR_DB_PATH=data/aar.db

# Logging level: DEBUG, INFO, WARNING, ERROR
AAR_LOG_LEVEL=INFO
